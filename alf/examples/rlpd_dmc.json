{
    "desc": "DM Control Tasks",
    "version": "hopper_rlpd_nc-10_nct-2-newton",
    "use_gpu": true,
    "gpus": [
        0, 1
    ],
    "max_worker_num": 4,
    "repeats": 1,
    "parameters": {
        "create_environment.env_name": [
            "hopper-hop"
        ],
        "RlpdAlgorithm.num_critic_replicas": "[10]",
        "RlpdAlgorithm.num_critic_targets": "[2]",
        "RlpdAlgorithm.use_entropy_reward": "[True]",
        "RlpdAlgorithm.target_update_tau": "[0.005]",
        "calc_default_target_entropy.min_prob": "[0.184]",
        "TrainerConfig.num_updates_per_train_iter": "[5, 10]",
        "TrainerConfig.random_seed": "list(range(2))"
    }
}
